# OpenAI API key with Realtime API access (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Twilio console credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number placing the call, E.164 format, e.g. +15551234567
TWILIO_PHONE_NUMBER=

# Public hostname server.py is reachable at, no scheme, e.g. from ngrok:
#   abc123.ngrok-free.app
# Used to build both wss://{PUBLIC_URL}/audio and the recording webhook URL.
PUBLIC_URL=
